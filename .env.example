# ==========================================
# SERVER & BOT CONFIGURATION (Alwaysdata / Node.js)
# ==========================================
PORT=8100
HOST=0.0.0.0
DEFAULT_PROVIDER=nvidia
AUTO_REPLY_ENABLED=true

# ==========================================
# SERVER-TO-SERVER SECURITY (Cloudflare <-> Alwaysdata)
# ==========================================
# Shared HMAC-SHA256 secret for authenticated internal communication
INTERNAL_API_KEY=your_secure_internal_api_key_here
# Master AES-256 encryption secret for BYOK keys at rest (Required in production)
ENCRYPTION_SECRET=your_32_byte_hex_encryption_secret_here

# Cloudflare -> Alwaysdata Base URL (Set on Cloudflare)
# ALWAYSDATA_BASE_URL=https://your-account.alwaysdata.net

# Admin Initial Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ==========================================
# GROQ PROVIDER & MODELS (Default Fallbacks)
# ==========================================
GROQ_API_KEYS=gsk_key1,gsk_key2
GROQ_ROUTER_MODEL=openai/gpt-oss-120b
GROQ_ROUTER_FALLBACK_MODELS=openai/gpt-oss-20b
GROQ_MODEL_SIMPLE=openai/gpt-oss-20b
GROQ_SIMPLE_FALLBACK_MODELS=qwen/qwen3-32b
GROQ_MODEL_REASONING=openai/gpt-oss-120b
GROQ_REASONING_FALLBACK_MODELS=qwen/qwen3-32b

# ==========================================
# NVIDIA NIM PROVIDER & MODELS (Default Fallbacks)
# ==========================================
NVIDIA_API_KEYS=nvapi-key1,nvapi-key2
NVIDIA_ROUTER_MODEL=openai/gpt-oss-20b
NVIDIA_ROUTER_FALLBACK_MODELS=openai/gpt-oss-120b
NVIDIA_MODEL_SIMPLE=minimaxai/minimax-m3
NVIDIA_SIMPLE_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MODEL_REASONING=z-ai/glm-5.2
NVIDIA_REASONING_FALLBACK_MODELS=deepseek-ai/deepseek-v4-pro
NVIDIA_MODEL_MULTIMODAL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_MULTIMODAL_FALLBACK_MODELS=moonshotai/kimi-k2.6,nvidia/nemotron-nano-12b-v2-vl,meta/llama-3.2-11b-vision-instruct

# ==========================================
# ANTI-BAN & RATE LIMITING
# ==========================================
ANTI_BAN_MIN_DELAY_MS=5000
ANTI_BAN_MAX_DELAY_MS=8000
RATE_LIMIT_MAX_PER_MINUTE=2

# ==========================================
# STORAGE & PATHS
# ==========================================
SESSION_DIR=./auth_sessions
DB_FILE_PATH=./db.json
SYSTEM_PROMPT_PATH=./system.md
